---
// src/layouts/Layout.astro

// On récupère le titre et la description passés par les pages
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
        <meta name="description" content={description || "Portfolio d'Ophélie Lamboray, développeuse web"} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		
        <slot />

        <footer>
			<p>&copy; 2025 Ophélie Lamboray. Tous droits réservés.</p>
			<a href="/mentions-legales">Mentions légales</a>
		</footer>

	</body>
</html>

<style is:global>
    /* Styles globaux de base (Reset) */
	:root {
		--bg-color: #F5F5F5;
		--text-color: #333;
	}
	
	html {
		font-family: system-ui, sans-serif;
		background: var(--bg-color);
		color: var(--text-color);
	}

	body {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
    
    /* NOTE : Le style du footer a été déplacé dans src/styles/home.css */
</style>