---
// src/layouts/Layout.astro

// On récupère le titre et la description passés par les pages
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description || "Portfolio d'Ophélie Lamboray, développeuse web"} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		
		<slot />

		<footer>
			<p>&copy; 2025 Ophélie Lamboray. Tous droits réservés.</p>
			<a href="/mentions-legales">Mentions légales</a>
		</footer>

	</body>
</html>